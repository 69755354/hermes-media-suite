+def _host_of_url(url):
+    """Hostname for tab bookkeeping; empty for blank/unparsable pages."""
+    text = str(url or "").strip()
+    if not text or text == "about:blank":
+        return ""
+    try:
+        return (urlparse(text).hostname or "").lower()
+    except Exception:
+        return ""
+
